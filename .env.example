# DineFlow Environment Configuration
# Copy this file to .env and fill in your actual values.

# Application
SECRET_KEY=your-super-secret-key-dineflow-2026
FLASK_ENV=development

# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=dineflow_db

# Business Settings
BUSINESS_NAME=DineFlow Restaurant
CURRENCY=GHS
TAX_RATE=0.00

# Uploads
UPLOAD_FOLDER=uploads

# Production Security
SESSION_COOKIE_SECURE=False
